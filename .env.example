# Render / local PostgreSQL URL. Never commit real secrets.
DATABASE_URL=
# Single administrator account for /admin. Set these privately in Render Environment.
ADMIN_USERNAME=MacMonster
ADMIN_PASSWORD=
# Waiting/invite panel timeout, in milliseconds (default 120 seconds).
ROOM_WAIT_TIMEOUT_MS=120000
# Remove stored IP addresses after this many days without a visit (default 30).
PROFILE_IP_RETENTION_DAYS=30
# Optional exact browser origins allowed to connect to /ws.
ALLOWED_ORIGINS=
